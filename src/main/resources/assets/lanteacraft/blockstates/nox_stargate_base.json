{
  "multipart": [
    {
      "when": { "assembled": false, "facing": "north" },
      "apply": { "model": "lanteacraft:block/nox_stargate_base" }
    },
    {
      "when": { "assembled": false, "facing": "east" },
      "apply": { "model": "lanteacraft:block/nox_stargate_base", "y": 90 }
    },
    {
      "when": { "assembled": false, "facing": "south" },
      "apply": { "model": "lanteacraft:block/nox_stargate_base", "y": 180 }
    },
    {
      "when": { "assembled": false, "facing": "west" },
      "apply": { "model": "lanteacraft:block/nox_stargate_base", "y": 270 }
    },
    {
      "when": { "assembled": true },
      "apply": { "model": "lanteacraft:block/empty" }
    }
  ]
}
